# Cyber Brief: пример настроек. Скопируйте в .env (install.sh делает это сам)
# и впишите свои значения: cp .env.example .env && chmod 600 .env
#
# Правила файла: одна переменная на строку, формат ИМЯ=значение, без кавычек
# и без пробелов вокруг «=». Строки с «#» — комментарии. Файл читают и бот,
# и одноразовые контейнеры, поэтому он хранит секреты: права 600, в git не
# попадает (.gitignore).

# ======================================================================
# ОБЯЗАТЕЛЬНЫЕ
# ======================================================================

# Токен бота от @BotFather (выглядит как 123456789:AAH...).
# Без него служба не стартует и пишет об этом в лог.
TELEGRAM_BOT_TOKEN=

# Ключ OpenAI (sk-...): им делается расшифровка и сам бриф.
# Без него бот запустится и ответит на команды, но встречи не пойдут:
# перед записью бот проверяет ключ и говорит, чего не хватает.
OPENAI_API_KEY=

# Чаты, которым можно пользоваться ботом: числовые chat_id через запятую,
# например 123456789,-1001234567890 (у личных чатов id положительный,
# у групп отрицательный). Пусто — бот никого не обслуживает и каждому
# отвечает только его chat_id: напишите боту, возьмите id из ответа,
# впишите сюда и перезапустите службу.
ALLOWED_CHATS=

# ======================================================================
# ЖЕЛАТЕЛЬНЫЕ
# ======================================================================

# Кто может привязывать новые чаты командой /link: user_id через запятую.
# Пусто — владельцами считаются личные чаты из ALLOWED_CHATS.
OWNER_IDS=

# Часовой пояс для времени в логах, именах записей и сообщениях.
# Без него — Europe/Moscow. Список: timedatectl list-timezones
TZ=Europe/Moscow

# Имя, под которым бот заходит на встречу: его видят все участники.
# Без него — «Cyber Brief».
BOT_NAME=Cyber Brief

# Сколько встреч писать одновременно. Каждая запись — отдельный браузер:
# около 0.5 ГБ памяти и до 0.8 ядра (замер на встрече вдвоём; на большой
# встрече больше). Без значения — 1. Прибавляйте по одной и смотрите /status.
MAX_CONCURRENT=1

# Модель для брифа. Без значения — gpt-5-mini. Расшифровка (диаризация)
# идёт отдельной моделью, её менять не нужно.
LLM_MODEL=gpt-5-mini

# ======================================================================
# НЕОБЯЗАТЕЛЬНЫЕ
# ======================================================================

# Подсказка модели брифа (на расшифровку не влияет): слова, которые у вас
# на встречах звучат часто и перевираются (названия продуктов, имена команд).
# Одной строкой, в произвольной форме. Пусто — берётся короткий общий
# список из brief.py. Пример (замените своими словами):
# STT_VOCABULARY=Рабочая встреча. Термины: Kubernetes, Postgres, деплой, спринт, бэклог. Имена: Иванов, Петрова.

# Свои правки перевранных слов в готовой стенограмме. Формат:
# шаблон=>замена, пары разделяются «;;». Шаблон — регулярное выражение
# Python без учёта регистра. Битая запись пропускается с сообщением в логе.
# Общие правки (Python, GitHub, Markdown, VPN...) уже в brief.py; здесь —
# то, что специфично для вашей команды. ВАЖНО: правки применяются только к
# стенограмме от локальной расшифровки (STT_BACKEND=local-first, см. ниже):
# OpenAI латиницу пишет сам, и на его пути эта переменная ничего не меняет.
# Для пути через OpenAI пользуйтесь STT_VOCABULARY. Ниже — пример механизма:
# раскомментируйте и замените своими словами.
# TERM_FIXES_EXTRA=куберн\w*=>Kubernetes;;постгр\w*=>Postgres;;деплойм\w*=>деплой

# Куда дополнительно отдавать готовый бриф: адреса через запятую, у каждого
# после «|» секрет для подписи, например
# https://example.com/hook|секрет1,https://other.example/hook|секрет2
# Пусто — брифы приходят только в Telegram. Формат запроса: docs/webhook.md.
WEBHOOKS=

# Каталог установки (там лежат jobs/, voices/, profile/ и этот файл).
# Обычно не нужен: install.sh задаёт его в юните systemd, а без него бот
# берёт каталог репозитория.
# AI_BRIEF_HOME=/opt/ai-brief

# Яндекс-аккаунт, под которым бот заходит на встречи, если в профиле
# браузера их несколько (например bot@yandex.ru). Без него — как есть.
# Работает после входа командой /login в боте.
YANDEX_ACCOUNT=

# Разрыв в минутах, в пределах которого две записи по одной ссылке считаются
# одной встречей. Без значения — 45.
# MERGE_GAP_MIN=45

# Сколько кусков аудио расшифровывать параллельно. Без значения — 4.
# STT_PARALLEL=4

# ----------------------------------------------------------------------
# Локальная расшифровка на своей видеокарте. ВСЁ ЭТО НУЖНО ТОЛЬКО ЕСЛИ
# у вас есть отдельный сервис gpu-hub — в этот репозиторий он не входит
# (см. docs/local-stt.md). Без него оставьте как есть: расшифровка идёт
# через OpenAI.
# ----------------------------------------------------------------------

# openai (по умолчанию) или local-first: сначала отдать запись на машину
# с видеокартой, а не дождавшись — считать через OpenAI.
# Нужен отдельный сервис: gpu-hub.
STT_BACKEND=openai

# Адрес сервиса gpu-hub, например https://hub.example.com. Нужен отдельный сервис.
GPUHUB_URL=

# Ключ доступа к gpu-hub. Нужен отдельный сервис.
GPUHUB_KEY=

# Сколько минут ждать машину с видеокартой, прежде чем считать через
# OpenAI. Установщик при подключении хаба ставит 120. Нужен отдельный сервис.
LOCAL_WAIT_MIN=25
